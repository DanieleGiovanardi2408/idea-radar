# Token GitHub (scope minimo, solo lettura) — API gratuita.
# Senza token funziona comunque, ma con rate limit molto più basso.
GITHUB_TOKEN=

# Token developer GRATUITO di Product Hunt: https://api.producthunt.com/v2/docs
# Obbligatorio per la fonte "producthunt" (disabilitata di default in config.yaml).
PRODUCTHUNT_TOKEN=

# LLM locale via Ollama
OLLAMA_HOST=http://localhost:11434

# Modello generativo di default (insight, mosse, angolo di business, etichette topic).
# Serve un modello capace: i modelli piccoli giudicano "low" quasi tutto.
#   ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# Opzionale: un modello più piccolo SOLO per gli insight per-item, che sono il
# collo di bottiglia dei run (~7s a item sul 7B). Mosse, angolo ed etichette
# restano sul modello di default. Vuoto = si usa OLLAMA_MODEL.
#   es. ollama pull qwen2.5:3b
OLLAMA_INSIGHT_MODEL=

# Modello per gli embedding: raggruppa item simili in una sola idea e le idee in topic.
#   ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# Se true, il run fallisce quando Ollama non risponde.
# Se false (default), ripiega su un insight euristico e prosegue.
LLM_REQUIRED=false

# Chiave GRATUITA per la YouTube Data API v3 (console.cloud.google.com): serve
# SOLO al pannello video del Radar. Senza, quel pannello si spegne da sé con un
# messaggio; nessuna parte della pipeline la usa.
YOUTUBE_API_KEY=
