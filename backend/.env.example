# Token GitHub (scope minimo, solo lettura) — API gratuita.
# Senza token funziona comunque, ma con rate limit molto più basso.
GITHUB_TOKEN=

# Token developer GRATUITO di Product Hunt: https://api.producthunt.com/v2/docs
# Obbligatorio per la fonte "producthunt" (disabilitata di default in config.yaml).
PRODUCTHUNT_TOKEN=

# LLM locale via Ollama
OLLAMA_HOST=http://localhost:11434

# Modello per gli insight (summary, why_text, difficulty).
# Serve un modello capace: i modelli piccoli giudicano "low" quasi tutto.
#   ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# Modello per gli embedding: raggruppa item simili in una sola idea e le idee in topic.
#   ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# Se true, il run fallisce quando Ollama non risponde.
# Se false (default), ripiega su un insight euristico e prosegue.
LLM_REQUIRED=false
